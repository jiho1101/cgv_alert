diff --git a/tests/api/cgv-theater-only.test.ts b/tests/api/cgv-theater-only.test.ts
new file mode 100644
index 0000000..f00f99a
--- /dev/null
+++ b/tests/api/cgv-theater-only.test.ts
@@ -0,0 +1,47 @@
+import { beforeEach, expect, it, vi } from 'vitest';
+import { handleCgvGetTimetable } from '../../src/api/cgvHandlers.js';
+import { fetchCgvTimetable } from '../../src/services/cgv/client.js';
+import { ServiceError } from '../../src/core/errors.js';
+
+vi.mock('../../src/services/cgv/client.js', () => ({
+  fetchCgvTimetable: vi.fn(), toYyyymmdd: () => '20261028',
+}));
+vi.mock('../../src/api/operationalFreshness.js', () => ({
+  isFreshOperationalRequest: async () => false,
+}));
+const fetchTimetable = vi.mocked(fetchCgvTimetable);
+function context(query: Record<string, string>) {
+  return { req: { query: (key: string) => query[key], raw: new Request('https://test/') },
+    json: vi.fn((payload: unknown, status = 200) => ({ payload, status })) }
+    as unknown as Parameters<typeof handleCgvGetTimetable>[0];
+}
+beforeEach(() => fetchTimetable.mockReset());
+it('명시한 극장별 원본의 빈 응답은 미확정 관측으로 반환한다', async () => {
+  fetchTimetable.mockResolvedValueOnce([]);
+  const c = context({ theaterCode: '0128', playDate: '20261218', queryMode: 'theater-only' });
+  await handleCgvGetTimetable(c);
+  expect(fetchTimetable).toHaveBeenCalledWith(expect.objectContaining({ theaterOnly: true }));
+  expect(c.json).toHaveBeenCalledWith(expect.objectContaining({ success: true,
+    data: expect.objectContaining({ queryMode: 'theater-only',
+      observation: 'empty_unconfirmed', timetable: [] }) }));
+});
+it('원본 502는 빈 응답 성공으로 바꾸지 않는다', async () => {
+  fetchTimetable.mockRejectedValueOnce(new ServiceError('CGV_RELAY_FAILED', 'relay failed', 502, true));
+  const c = context({ theaterCode: '0128', queryMode: 'theater-only' });
+  await handleCgvGetTimetable(c);
+  expect(c.json).toHaveBeenCalledWith(expect.objectContaining({ success: false }), 502);
+});
+it.each([{ queryMode: 'unknown' }, { queryMode: 'theater-only' }])(
+  '잘못되거나 극장이 없는 원본 관측 요청을 원본 호출 전에 거부한다', async (query) => {
+    const c = context(query);
+    await handleCgvGetTimetable(c);
+    expect(c.json).toHaveBeenCalledWith(expect.objectContaining({ success: false }), 400);
+    expect(fetchTimetable).not.toHaveBeenCalled();
+  });
+it('기본 요청에 원본 관측 모드 응답을 추가하지 않는다', async () => {
+  fetchTimetable.mockResolvedValueOnce([]);
+  const c = context({ theaterCode: '0128' });
+  await handleCgvGetTimetable(c);
+  expect(c.json).toHaveBeenCalledWith(expect.objectContaining({
+    data: expect.not.objectContaining({ queryMode: 'theater-only' }) }));
+});
diff --git a/tests/services/cgv/theater-only.test.ts b/tests/services/cgv/theater-only.test.ts
new file mode 100644
index 0000000..886acf2
--- /dev/null
+++ b/tests/services/cgv/theater-only.test.ts
@@ -0,0 +1,50 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { fetchCgvTimetable } from '../../../src/services/cgv/client.js';
+import { requestCgv } from '../../../src/services/cgv/transport.js';
+
+vi.mock('../../../src/services/cgv/transport.js', () => ({ requestCgv: vi.fn() }));
+const request = vi.mocked(requestCgv);
+const params = { theaterCode: '0128', playDate: '20261218', theaterOnly: true };
+const row = {
+  siteNo: '0128', siteNm: '울산삼산', scnYmd: '20261218', scnSseq: '1',
+  movNo: '30009999', movNm: '검증 영화', scnsrtTm: '1000', scnendTm: '1200',
+  stcnt: 441, frSeatCnt: 440,
+};
+
+beforeEach(() => request.mockReset());
+describe('극장별 원본 관측 모드', () => {
+  it('유효한 빈 응답 뒤 영화 목록 폴백을 호출하지 않는다', async () => {
+    request.mockResolvedValueOnce({ statusCode: 0, data: [] });
+    await expect(fetchCgvTimetable(params)).resolves.toEqual([]);
+    expect(request).toHaveBeenCalledTimes(1);
+  });
+  it('원본 오류를 빈 응답으로 바꾸지 않는다', async () => {
+    request.mockRejectedValueOnce(new Error('CGV_RELAY_FAILED'));
+    await expect(fetchCgvTimetable(params)).rejects.toThrow('CGV_RELAY_FAILED');
+    expect(request).toHaveBeenCalledTimes(1);
+  });
+  it('기본 모드의 기존 폴백과 오류 동작을 유지한다', async () => {
+    request.mockResolvedValueOnce({ statusCode: 0, data: [] });
+    request.mockRejectedValueOnce(new Error('legacy fallback failed'));
+    await expect(fetchCgvTimetable({ ...params, theaterOnly: false }))
+      .rejects.toThrow('legacy fallback failed');
+    expect(request).toHaveBeenCalledTimes(2);
+  });
+  it('게시된 실제 필드의 정규화와 회차 식별자를 유지한다', async () => {
+    request.mockResolvedValueOnce({ statusCode: 0, data: [row] });
+    const rows = await fetchCgvTimetable(params);
+    expect(rows[0]).toMatchObject({ scheduleId: '2026121801281', movieCode: '30009999',
+      theaterCode: '0128', playDate: '20261218', startTime: '10:00',
+      totalSeats: 441, remainingSeats: 440 });
+    expect(request).toHaveBeenCalledTimes(1);
+  });
+  it('영화 필터가 없으면 전체 극장 원본을 반환한다', async () => {
+    request.mockResolvedValueOnce({ statusCode: 0, data: [row] });
+    expect(await fetchCgvTimetable(params)).toHaveLength(1);
+  });
+  it('영화 필터 불일치가 개별 영화 폴백을 호출하지 않는다', async () => {
+    request.mockResolvedValueOnce({ statusCode: 0, data: [row] });
+    expect(await fetchCgvTimetable({ ...params, movieCode: 'OTHER' })).toEqual([]);
+    expect(request).toHaveBeenCalledTimes(1);
+  });
+});
